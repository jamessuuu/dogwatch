        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "reasonCode": {
            "type": "string",
            "enum": [
              "store_unavailable",
              "duplicate_suppressed",
              "gate_timed_out",
              "circuit_open",
              "not_confirmed"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "subject",
          "reasonCode",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "cost": {
      "type": "object",
      "properties": {
