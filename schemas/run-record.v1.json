    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "enum": [
              "reach",
              "header",
              "brand",
              "link",
              "weight",
              "artifact",
              "repo",
              "pkg",
              "watch"
