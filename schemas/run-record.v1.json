            "required": [
              "method",
              "url",
              "headersSent",
              "timeoutMs"
            ],
            "additionalProperties": false
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "finding",
              "error",
              "skipped",
              "pending"
            ]
          },
          "skipReason": {
            "type": "string",
            "enum": [
              "not_published",
              "not_applicable",
              "no_baseline",
              "circuit_open",
              "rate_limited"
            ]
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "timeout",
              "network_error",
              "http_error",
              "parse_error",
              "forbidden",
              "unreachable"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "finalUrl": {
                "type": "string"
              },
              "redirects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "url"
                  ],
                  "additionalProperties": false
                }
              },
              "headers": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "bodySha256": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "ms": {
                "type": "number",
                "minimum": 0
              },
              "tlsNotAfter": {
                "type": "string"
              },
              "json": {},
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "redirects",
              "headers"
            ],
            "additionalProperties": false
          },
          "reproduce": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "family",
          "targetId",
          "ruleId",
          "title",
          "request",
          "observedAt",
          "verdict",
          "evidence",
          "reproduce"
