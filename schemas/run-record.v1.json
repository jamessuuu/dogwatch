        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-"
          },
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "unconfirmed",
              "confirmed"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "method": {
                  "type": "string"
                },
                "status": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "retrievedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                "evidencePath": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "url",
                "method",
                "status",
                "retrievedAt",
                "evidencePath"
              ],
              "additionalProperties": false
            }
          },
          "firstSeenRunId": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "advisory": {
            "type": "object",
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "note": {
                "type": "string",
                "maxLength": 600
              },
              "model": {
                "type": "string"
              },
              "agreesWithRule": {
                "type": "boolean"
              }
            },
            "required": [
              "severity",
              "note",
              "model",
              "agreesWithRule"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "checkId",
          "ruleId",
          "severity",
          "status",
          "statement",
          "sources",
          "firstSeenRunId",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "absenceOfEvidence": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "checksClean": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "byFamily": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "notChecked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "checkId": {
                "type": "string",
                "minLength": 1
              },
              "reasonCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "not_published",
                      "not_applicable",
                      "no_baseline",
                      "circuit_open",
                      "rate_limited"
                    ]
                  },
                  {
                    "type": "string",
                    "enum": [
                      "timeout",
                      "network_error",
                      "http_error",
                      "parse_error",
                      "forbidden",
                      "unreachable"
                    ]
                  }
                ]
              }
            },
            "required": [
              "checkId",
              "reasonCode"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "statement",
        "checksClean",
        "byFamily",
        "notChecked"
      ],
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "delta": {
            "type": "number"
          },
          "note": {
            "type": "string",
            "const": "recorded, not judged"
          }
        },
        "required": [
          "id",
          "targetId",
          "name",
          "value",
          "unit",
          "note"
        ],
        "additionalProperties": {}
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "issue.open",
              "issue.comment"
