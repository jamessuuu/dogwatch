          "reasonCode": {
            "type": "string",
            "enum": [
              "store_unavailable",
              "duplicate_suppressed",
              "gate_timed_out",
              "circuit_open",
              "not_confirmed"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "target",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
