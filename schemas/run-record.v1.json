          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "gated_pending",
              "executed",
              "refused"
            ]
          },
          "gateId": {
            "type": "string"
          },
          "effectKey": {
            "type": "string"
          },
          "effectOutcome": {
            "type": "string"
          },
          "artifactUrl": {
            "type": "string",
            "format": "uri"
          },
          "draft": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "body": {
                "type": "string",
                "minLength": 1
              },
              "author": {
                "type": "string",
