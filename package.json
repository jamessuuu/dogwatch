{
  "name": "dogwatch-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "e2e:smoke": "pnpm --filter @dogwatch/web run e2e:smoke",
    "eval": "vitest run --project eval --passWithNoTests",
    "build": "pnpm -r build",
    "schema:gen": "tsx scripts/gen-schema.mjs",
    "schema:check": "tsx scripts/gen-schema.mjs --check",
    "render": "tsx packages/dogwatch/src/cli/index.ts render",
    "render:check": "tsx packages/dogwatch/src/cli/index.ts render --check",
    "verify": "tsx packages/dogwatch/src/cli/index.ts verify",
    "dogwatch": "tsx packages/dogwatch/src/cli/index.ts",
    "brand": "node scripts/brand.mjs --project=dogwatch --out=apps/web/public/brand",
    "brand:check": "node scripts/brand-check.mjs",
    "diagram": "node scripts/diagram.mjs --out=apps/web/public/diagram/gate-flow.svg",
    "diagram:check": "node scripts/diagram-check.mjs",
    "readme:check": "node scripts/readme-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "next": "^16.3.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.1.10",
    "zod": "^4.0.0"
  }
}
