{
  "name": "@dogwatch/web",
  "version": "0.0.0",
  "private": true,
  "description": "The site (SPEC §10, M6): every page prerendered from committed JSON. The only route handler in the product is /api/gate/decide, which is M5 — this ships zero route handlers.",
  "type": "module",
  "scripts": {
    "build:deps": "node ../../scripts/build-native-deps.mjs",
    "dev": "pnpm run build:deps && next dev --webpack",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.json --noEmit",
    "build": "pnpm run build:deps && next build --webpack",
    "start": "next start",
    "e2e:smoke": "pnpm run build && playwright test"
  },
  "dependencies": {
    "@jamessuuu/sluice": "link:../../../sluice/packages/sluice",
    "dogwatch": "workspace:*",
    "next": "^16.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.3"
  }
}
